FROM localhost/linux-oss-toolset-builder:el8-20260923
USER root
COPY kernel-uapi.rpm /tmp/kernel-uapi.rpm
RUN dnf -y --disablerepo='*' --setopt=localpkg_gpgcheck=False install /tmp/kernel-uapi.rpm \
    && test -f /usr/include/selinux/label.h \
    && ln -s /usr/include/selinux /opt/linux-oss/kernel-uapi-7.2.7/include/selinux \
    && rm /tmp/kernel-uapi.rpm
USER builder
