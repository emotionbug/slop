--- a/bfd/format.c
+++ b/bfd/format.c
@@ -418,6 +418,32 @@
 	  }
 	}
 
+      /* GCC 8 and earlier have LTO sections but no .gnu.lto_.lto header.
+         Preserve their original slim marker and classify fat objects too.
+         Otherwise an ld -r mixed link silently drops native definitions. */
+      if (type == lto_non_ir_object
+          && bfd_get_flavour (abfd) == bfd_target_elf_flavour)
+        for (sec = abfd->sections; sec != NULL; sec = sec->next)
+          if (startswith (sec->name, ".gnu.lto_"))
+            {
+              long storage, count, i;
+              asymbol **syms;
+              type = lto_fat_ir_object;
+              abfd->lto_type = type;
+              storage = bfd_get_symtab_upper_bound (abfd);
+              if (storage > 0 && (syms = bfd_malloc (storage)) != NULL)
+                {
+                  count = bfd_canonicalize_symtab (abfd, syms);
+                  for (i = 0; i < count; i++)
+                    if (bfd_lto_slim_symbol_p (abfd, syms[i]->name))
+                      {
+                        type = lto_slim_ir_object;
+                        break;
+                      }
+                  free (syms);
+                }
+              break;
+            }
       abfd->lto_type = type;
     }
 }
