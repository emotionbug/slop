 	msr_set_bit(MSR_AMD64_FP_CFG, MSR_AMD64_FP_CFG_ZEN1_DENORM_FIX_BIT);
+
+	/*
+	 * Some Zen4 client SoCs advertise virtualized VMLOAD/VMSAVE even
